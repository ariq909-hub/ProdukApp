<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="toko.controller.DaftarProdukController"
            stylesheets="@styles/app.css">
    <top>
        <VBox spacing="12" styleClass="header">
            <Label text="Daftar Produk Toko" styleClass="title"/>
            <HBox spacing="10">
                <TextField fx:id="cariField" promptText="Cari nama produk..." onAction="#cari" HBox.hgrow="ALWAYS"/>
                <Button text="Cari" onAction="#cari" styleClass="button-primary"/>
            </HBox>
            <FlowPane hgap="10" vgap="8">
                <Button text="Tambah Produk Baru" onAction="#tambah" styleClass="button-primary"/>
                <Button text="Lihat Detail" onAction="#detail"/>
                <Button text="Edit Produk" onAction="#edit"/>
                <Button text="Hapus" onAction="#hapus"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="kodeCol" text="Kode" prefWidth="120"/>
                <TableColumn fx:id="namaCol" text="Nama Produk" prefWidth="250"/>
                <TableColumn fx:id="kategoriCol" text="Kategori" prefWidth="150"/>
                <TableColumn fx:id="hargaCol" text="Harga (Rp)" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" wrapText="true" styleClass="error"/>
    </bottom>
</BorderPane>